  },
  "dependencies": {
    "@mt/config": "file:packages/config",
    "@mt/design-tokens": "file:packages/design-tokens",
    "@mt/domain": "file:packages/domain",
    "@mt/shared-types": "file:packages/shared-types",
    "@mt/ui": "file:packages/ui",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "^7.18.5",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
