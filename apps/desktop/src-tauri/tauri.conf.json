{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Menstruation Tracker",
  "version": "0.3.1",
  "identifier": "app.menstruationtracker.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../.. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../.. run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Menstruation Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "category": "Medical",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Menstruation Tracker",
    "shortDescription": "Private, local-first menstrual health tracker"
  }
}
